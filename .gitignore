# Godot 4+ specific ignores
.godot/
/android/

# 本地存档(不提交)
/save/

# AI 助手工作目录(开发日志/记忆,不提交)
/.workbuddy/

# 原始素材包(带 .gdignore、不参与构建,仅开发备份;CC0 可随时重新下载)
/assets/crawl-tiles/
/assets/roguelike/
/assets/dungeontileset2/
/assets/*.zip

# IvoryRed raw 素材(54个原始图标,已精选7个到 sprites/;保留备份)
/assets/sprites_raw/

# 临时调试目录
/_debug_backup/
/_test/
/.godot_bak2/
/_test_parse.gd
/_test_parse.gd.uid

# Versioned player packages live locally; commit their manifest and release notes.
/releases/**/*.zip
/releases/**/*.exe
/releases/**/*.pck
/build/**/*.exe
/build/**/*.pck
/build/**/*.zip
